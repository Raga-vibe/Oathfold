# Oathfold is a Vite + React + TypeScript static SPA. No build step is needed to
# run it after `npm run build`; the output in dist/ is plain static files.
# All chain reads use the public X Layer RPCs below. No secrets are used.
# Copy to .env.local only if you need to override a value.

# Primary X Layer RPC (default: https://rpc.xlayer.tech)
VITE_RPC_URL=https://rpc.xlayer.tech
# Secondary X Layer RPC (default: https://xlayerrpc.okx.com)
VITE_RPC_URL_SECONDARY=https://xlayerrpc.okx.com
# DeWEB hub proxy on X Layer (default: 0xe61A9C7213a6Aa616C246a2B569e555B417b25ee)
VITE_HUB_ADDRESS=0xe61A9C7213a6Aa616C246a2B569e555B417b25ee
